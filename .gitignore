# Secrets — never commit real credentials
.env

# Python
__pycache__/
*.pyc
.venv/

# AWS CLI installer artifacts (install it outside the repo, e.g. /tmp)
awscliv2.zip
/aws/

# Local sample media used by lessons — each lesson's assets/README.md explains
# how to add your own; don't commit large personal sample files
lessons/*/assets/images/*.jpg
lessons/*/assets/images/*.jpeg
lessons/*/assets/images/*.png

# KodeFood Vendor Portal — Stage 1 local uploads (keep the directory)
lessons/00-the-real-job/vendor_portal/uploads/*
!lessons/00-the-real-job/vendor_portal/uploads/.gitkeep
lessons/00-the-real-job/vendor_portal/.venv/
vendor_portal/

