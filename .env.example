# AWS CLI credentials are stored outside this repository by `aws configure`.
AWS_DEFAULT_REGION=ap-northeast-1

# Ordinary S3 stores images and caption files.
S3_BUCKET=your-gpu-teaching-bucket

# Existing AWS Batch course resources and container image.
BATCH_JOB_QUEUE=gpu-teaching-queue
BATCH_JOB_DEFINITION=gpu-teaching-job-def
ECR_IMAGE_URI=123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/gpu-teaching:latest
