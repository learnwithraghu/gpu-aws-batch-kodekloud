# AWS CLI credentials are stored outside this repository by `aws configure`.
AWS_DEFAULT_REGION=ap-northeast-1

# Ordinary S3 stores images and caption files.
# helpers/create_buckets.sh fills in the two buckets below automatically
# (idempotent — buckets that already exist are not recreated).
#   S3_IMAGES_BUCKET : raw images, uploaded manually by the tutor
#   S3_CSV_BUCKET    : CSV files with pointer-to-image + caption
# S3_BUCKET is the legacy single-bucket variable (kept for lesson scripts)
# and defaults to the images bucket once the buckets exist.
S3_BUCKET=gpu-teaching-images-666234783044
S3_IMAGES_BUCKET=gpu-teaching-images-666234783044
S3_CSV_BUCKET=gpu-teaching-captions-csv-666234783044

# AWS Batch course resources and container image (ap-northeast-1).
BATCH_JOB_QUEUE=gpu-teaching-gpu-smoke-queue-spot
BATCH_JOB_DEFINITION=gpu-teaching-caption-job
# IAM role the caption container assumes for S3 (not the EC2 instance role).
BATCH_JOB_ROLE_ARN=arn:aws:iam::<account-id>:role/gpu-teaching-batch-job-role
ECR_IMAGE_URI=666234783044.dkr.ecr.ap-northeast-1.amazonaws.com/gpu-teaching:latest
